generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  DOCTOR
  STAFF
  ADMIN
}

enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  role           Role
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  patientProfile PatientProfile?
  doctorProfile  DoctorProfile?

  @@map("users")
}

model PatientProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName    String
  lastName     String
  dateOfBirth  DateTime
  gender       Gender
  phone        String
  address      String
  bloodType    String?
  status       AccountStatus @default(PENDING)
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  vitals       VitalSign[]

  @@map("patient_profiles")
}

model VitalSign {
  id        String         @id @default(cuid())
  patientId String
  patient   PatientProfile @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type      VitalType
  value     String
  unit      String
  takenAt   DateTime       @default(now())
  createdAt DateTime       @default(now())

  @@index([patientId, type, takenAt(sort: Desc)])
  @@map("vital_signs")
}

enum VitalType {
  WEIGHT
  BLOOD_PRESSURE
  TEMPERATURE
  PULSE
}

model DoctorProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  firstName     String
  lastName      String
  specialty     String
  phone         String
  licenseNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("doctor_profiles")
}

// ─── Public website CMS ────────────────────────────────────────────────────

enum PostCategory {
  NEWS
  EVENT
  AWARD
}

/// News & press releases, events & conferences, awards — managed from /admin/website.
model Post {
  id          String       @id @default(cuid())
  slug        String       @unique
  title       String
  category    PostCategory @default(NEWS)
  excerpt     String
  body        String
  imageUrl    String?
  eventDate   DateTime?
  location    String?
  published   Boolean      @default(true)
  publishedAt DateTime     @default(now())
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([published, category, publishedAt(sort: Desc)])
  @@map("posts")
}

enum ServiceGroup {
  SPECIALTY_HUB
  SPICE
  CANCER_CARE
  ANCILLARY
}

/// Specialty centers and ancillary services shown on /services.
model ServiceCenter {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  shortName String?
  group     ServiceGroup
  tagline   String?
  summary   String
  body      String
  offerings String[]
  schedule  String?
  phone     String?
  location  String?
  sortOrder Int          @default(0)
  published Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([published, group, sortOrder])
  @@map("service_centers")
}

/// Clinical departments — also the grouping for the public doctor directory.
model ClinicalDepartment {
  id               String            @id @default(cuid())
  slug             String            @unique
  name             String
  description      String
  chairman         String?
  hasResidency     Boolean           @default(false)
  facebookUrl      String?
  sortOrder        Int               @default(0)
  published        Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  directoryDoctors DirectoryDoctor[]

  @@map("clinical_departments")
}

/// Public "Find a doctor" listing (clinic room, hours, local). Separate from
/// DoctorProfile, which is a portal login account.
model DirectoryDoctor {
  id           String             @id @default(cuid())
  firstName    String
  lastName     String
  departmentId String
  department   ClinicalDepartment @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  specialty    String?
  room         String?
  schedule     String?
  local        String?
  phone        String?
  published    Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([departmentId, lastName])
  @@map("directory_doctors")
}

enum InquiryType {
  GENERAL
  APPOINTMENT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESOLVED
}

/// Contact-us messages and appointment requests submitted from the website.
model Inquiry {
  id            String        @id @default(cuid())
  type          InquiryType
  status        InquiryStatus @default(NEW)
  name          String
  email         String
  phone         String?
  subject       String?
  message       String
  department    String?
  doctor        String?
  preferredDate DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@map("inquiries")
}
